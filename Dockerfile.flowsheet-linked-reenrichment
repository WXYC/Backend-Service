# Build stage: consumes the shared dist-export image (built once per deploy
# by Dockerfile.deploy-builder) instead of running its own npm ci + build.
# See docs/deploy.md "Shared builder image".
ARG BUILDER_IMAGE=wxyc-deploy-builder:local
FROM ${BUILDER_IMAGE} AS builder

#Production stage
FROM node:24-alpine AS prod

ARG NPM_TOKEN
WORKDIR /flowsheet-linked-reenrichment

COPY ./.npmrc ./
COPY ./package* ./
COPY ./jobs/flowsheet-linked-reenrichment/package* ./jobs/flowsheet-linked-reenrichment/
COPY ./shared/database/package* ./shared/database/
COPY ./shared/lml-client/package* ./shared/lml-client/
COPY ./shared/metadata/package* ./shared/metadata/

# `@wxyc/lml-client` declares `@wxyc/shared` as a registry dependency
# (GitHub Packages, `@wxyc:registry` in `.npmrc`). Without NPM_TOKEN +
# .npmrc the prod stage's npm install 401s on @wxyc/shared. Mirrors the
# pattern in Dockerfile.album-level-backfill / Dockerfile.backend.
RUN npm install --omit=dev && rm -f .npmrc

COPY --link --from=builder /jobs/flowsheet-linked-reenrichment/dist ./jobs/flowsheet-linked-reenrichment/dist
COPY --link --from=builder /shared/database/dist ./shared/database/dist
COPY --link --from=builder /shared/lml-client/dist ./shared/lml-client/dist
COPY --link --from=builder /shared/metadata/dist ./shared/metadata/dist

# Identifies the connection in pg_stat_activity during incident triage.
ENV DB_APPLICATION_NAME=wxyc-flowsheet-linked-reenrichment

# ENTRYPOINT + empty CMD so docker-level args (e.g. `--execute`) pass through
# to the job rather than replacing the launcher. With `CMD ["npm", "start"]`,
# `docker run <image> --execute` replaces the whole command and node tries to
# parse `--execute` itself. ENTRYPOINT pins the launcher; any args after
# `<image>` extend it.
ENTRYPOINT ["node", "/flowsheet-linked-reenrichment/jobs/flowsheet-linked-reenrichment/dist/job.js"]
CMD []
