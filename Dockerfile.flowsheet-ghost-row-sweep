# Build stage: consumes the shared dist-export image (built once per deploy
# by Dockerfile.deploy-builder) instead of running its own npm ci + build.
# See docs/deploy.md "Shared builder image".
ARG BUILDER_IMAGE=wxyc-deploy-builder:local
FROM ${BUILDER_IMAGE} AS builder

#Production stage
FROM node:24-alpine AS prod

ARG NPM_TOKEN
WORKDIR /flowsheet-ghost-row-sweep

COPY ./.npmrc ./
COPY ./package* ./
COPY ./jobs/flowsheet-ghost-row-sweep/package* ./jobs/flowsheet-ghost-row-sweep/
COPY ./shared/database/package* ./shared/database/

RUN npm install --omit=dev && rm -f .npmrc

COPY --link --from=builder /jobs/flowsheet-ghost-row-sweep/dist ./jobs/flowsheet-ghost-row-sweep/dist
COPY --link --from=builder /shared/database/dist ./shared/database/dist

# The candidate SELECTs walk `flowsheet` (2.6M rows) with an id-cursor scan;
# the API's tight 5s default statement timeout is too aggressive for the
# batch scans as the cursor advances.
ENV DB_STATEMENT_TIMEOUT_MS=300000

# Async commit. A mid-run failure the Node client SEES (a thrown error) never
# strands a page: the resume cursor only advances after a page's DELETE
# commits, so an unwritten row is just re-selected and re-tested on the next
# run. Async commit's real risk is a crash the client DOESN'T see — a page
# the client believed had committed, lost to a Postgres crash inside the
# fsync window, with the cursor already past it. That's what the job's
# post-run verification pass (orchestrate.ts, real-PG re-scan after
# --execute) exists to catch: it fails the run loudly instead of leaving a
# silent permanent leftover behind an already-advanced cursor.
ENV DB_SYNCHRONOUS_COMMIT=off

# Identifies the connection in pg_stat_activity during triage.
ENV DB_APPLICATION_NAME=wxyc-flowsheet-ghost-row-sweep

# ENTRYPOINT + empty CMD so docker-level args (`--execute`, `--dry-run`)
# pass through to the job rather than replacing the launcher — the
# Dockerfile.streaming-url-remediation pattern. With `CMD ["npm", "start"]`,
# `docker run <image> --execute` would REPLACE the CMD and npm would never run.
ENTRYPOINT ["node", "/flowsheet-ghost-row-sweep/jobs/flowsheet-ghost-row-sweep/dist/job.js"]
CMD []
