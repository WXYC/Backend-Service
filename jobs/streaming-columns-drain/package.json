{
  "name": "@wxyc/streaming-columns-drain",
  "job-type": "one-shot",
  "version": "1.0.0",
  "description": "WXYC one-shot drain (BS#2295): fill the five streaming URL columns on album_metadata rows that carry a load-bearing Discogs match but no streaming URLs at all, so they stop serving a terminal enriched_match with five permanent nulls.",
  "type": "module",
  "main": "./dist/job.js",
  "scripts": {
    "start": "node dist/job.js",
    "build": "tsup --minify",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "docker:build": "docker build -t wxyc_streaming_columns_drain:ci -f ../../Dockerfile.streaming-columns-drain ../../",
    "dev": "tsup --watch"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "dependencies": {
    "@sentry/node": "^10.70.0",
    "@wxyc/database": "^1.0.0",
    "@wxyc/lml-client": "^1.0.0",
    "@wxyc/metadata": "^1.0.0"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
