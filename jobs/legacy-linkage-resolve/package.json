{
  "name": "@wxyc/legacy-linkage-resolve",
  "cron-schedule": "*/30 * * * *",
  "version": "1.0.0",
  "description": "WXYC legacy linkage resolve: link flowsheet/rotation rows to library albums whose library row landed after the row was written",
  "type": "module",
  "main": "./dist/job.js",
  "scripts": {
    "start": "node dist/job.js",
    "build": "tsup --minify",
    "clean": "rm -rf dist",
    "docker:build": "docker build -t wxyc_legacy_linkage_resolve:ci -f ../../Dockerfile.legacy-linkage-resolve ../../",
    "dev": "tsup --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "^10.69.0",
    "@wxyc/database": "^1.0.0"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
