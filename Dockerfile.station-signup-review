#Build stage
FROM node:24-alpine AS builder

ARG NPM_TOKEN
WORKDIR /station-signup-review-builder

COPY ./.npmrc ./
COPY ./package.json ./package-lock.json ./
COPY ./tsconfig.base.json ./
COPY ./shared/database ./shared/database
COPY ./jobs/station-signup-review ./jobs/station-signup-review

RUN npm ci && npm run build --workspace=@wxyc/database --workspace=@wxyc/station-signup-review

#Production stage
FROM node:24-alpine AS prod

ARG NPM_TOKEN
WORKDIR /station-signup-review

COPY ./.npmrc ./
COPY ./package* ./
COPY ./jobs/station-signup-review/package* ./jobs/station-signup-review/
COPY ./shared/database/package* ./shared/database/

RUN npm install --omit=dev && rm -f .npmrc

COPY --from=builder ./station-signup-review-builder/jobs/station-signup-review/dist ./jobs/station-signup-review/dist
COPY --from=builder ./station-signup-review-builder/shared/database/dist ./shared/database/dist

# Statement timeout left at the API's 5s default, deliberately.
#
# NOT because the reads are indexed -- they are not. Neither `self_signup_at`
# nor `self_signup_reviewed_at` carries an index (migration 0160 indexes only
# `self_signup_reviewed_by`, the self-referencing FK column, and 0161 adds
# `self_signup_downgraded_at` unindexed), so the pending-cohort read is a
# sequential scan of `auth_user`. That is fine at this table's size -- low
# thousands of rows, one scan per day -- and the reason is the table, not the
# plan. Revisit the timeout, not just the index, if `auth_user` ever grows an
# order of magnitude.
#
# Everything after that read is per-account and tiny: at most one `auth_member`
# lookup, one `shows` probe (served by the partial index
# `shows_open_start_time_idx`), and one short transaction per downgrade, over a
# cohort that is a handful of rows because self-signup is a rare event. No bulk
# write pass, so none of the long-timeout / async-commit tuning the paged
# sweeps carry applies here.

# Identifies the connection in pg_stat_activity during triage.
ENV DB_APPLICATION_NAME=wxyc-station-signup-review

ENTRYPOINT ["node", "/station-signup-review/jobs/station-signup-review/dist/job.js"]
