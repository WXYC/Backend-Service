#Build stage
FROM node:24-alpine AS builder

ARG NPM_TOKEN
WORKDIR /station-signup-review-builder

COPY ./.npmrc ./
COPY ./package.json ./package-lock.json ./
COPY ./tsconfig.base.json ./
COPY ./shared/database ./shared/database
COPY ./jobs/station-signup-review ./jobs/station-signup-review

RUN npm ci && npm run build --workspace=@wxyc/database --workspace=@wxyc/station-signup-review

#Production stage
FROM node:24-alpine AS prod

ARG NPM_TOKEN
WORKDIR /station-signup-review

COPY ./.npmrc ./
COPY ./package* ./
COPY ./jobs/station-signup-review/package* ./jobs/station-signup-review/
COPY ./shared/database/package* ./shared/database/

RUN npm install --omit=dev && rm -f .npmrc

COPY --from=builder ./station-signup-review-builder/jobs/station-signup-review/dist ./jobs/station-signup-review/dist
COPY --from=builder ./station-signup-review-builder/shared/database/dist ./shared/database/dist

# One indexed-column filter over auth_user plus a handful of small
# per-account UPDATEs against auth_member -- both well inside the API's
# 5s default statement timeout. Left at the default deliberately: this is a
# short read-mostly job with no bulk write pass, so it doesn't need the
# long-timeout / async-commit tuning the paged sweeps carry.

# Identifies the connection in pg_stat_activity during triage.
ENV DB_APPLICATION_NAME=wxyc-station-signup-review

ENTRYPOINT ["node", "/station-signup-review/jobs/station-signup-review/dist/job.js"]
