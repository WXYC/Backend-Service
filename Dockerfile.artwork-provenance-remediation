#Build stage
FROM node:24-alpine AS builder

ARG NPM_TOKEN
WORKDIR /artwork-provenance-remediation-builder

COPY ./.npmrc ./
COPY ./package.json ./package-lock.json ./
COPY ./tsconfig.base.json ./
COPY ./shared/database ./shared/database
COPY ./shared/lml-client ./shared/lml-client
COPY ./shared/metadata ./shared/metadata
COPY ./jobs/artwork-provenance-remediation ./jobs/artwork-provenance-remediation

RUN npm ci && npm run build --workspace=@wxyc/database --workspace=@wxyc/lml-client --workspace=@wxyc/metadata --workspace=@wxyc/artwork-provenance-remediation

#Production stage
FROM node:24-alpine AS prod

ARG NPM_TOKEN
WORKDIR /artwork-provenance-remediation

COPY ./.npmrc ./
COPY ./package* ./
COPY ./jobs/artwork-provenance-remediation/package* ./jobs/artwork-provenance-remediation/
COPY ./shared/database/package* ./shared/database/
COPY ./shared/lml-client/package* ./shared/lml-client/
COPY ./shared/metadata/package* ./shared/metadata/

# `@wxyc/lml-client` declares `@wxyc/shared` as a registry dependency
# (GitHub Packages, `@wxyc:registry` in `.npmrc`). Mirrors the pattern in
# Dockerfile.flowsheet-metadata-backfill.
RUN npm install --omit=dev && rm -f .npmrc

COPY --from=builder ./artwork-provenance-remediation-builder/jobs/artwork-provenance-remediation/dist ./jobs/artwork-provenance-remediation/dist
COPY --from=builder ./artwork-provenance-remediation-builder/shared/database/dist ./shared/database/dist
COPY --from=builder ./artwork-provenance-remediation-builder/shared/lml-client/dist ./shared/lml-client/dist
COPY --from=builder ./artwork-provenance-remediation-builder/shared/metadata/dist ./shared/metadata/dist

# Long-running per-statement timeout: the enumeration reads every
# Discogs-hosted `album_metadata.artwork_url` in one pass (41,333 rows as of
# 2026-08-24) against no covering index. The orchestrator's own SET LOCAL
# statement_timeout (default 5 min) caps that scan; this env raises the
# connection default so per-row UPDATEs in the long tail aren't tripped.
ENV DB_STATEMENT_TIMEOUT_MS=300000

# Async commit: each per-row COMMIT returns as soon as the WAL hits the
# OS buffer. Safe because the write is idempotent — its WHERE pins the
# artwork_url the selector read, so a row lost to a crash simply re-selects
# on the next run and a row already healed falls out of the predicate.
ENV DB_SYNCHRONOUS_COMMIT=off

# Identifies the connection in pg_stat_activity during incident triage.
ENV DB_APPLICATION_NAME=wxyc-artwork-provenance-remediation

CMD ["npm", "start", "--workspace=@wxyc/artwork-provenance-remediation"]
