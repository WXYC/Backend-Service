# Build stage: consumes the shared dist-export image (built once per deploy
# by Dockerfile.deploy-builder) instead of running its own npm ci + build.
# See docs/deploy.md "Shared builder image".
ARG BUILDER_IMAGE=wxyc-deploy-builder:local
FROM ${BUILDER_IMAGE} AS builder

#Production stage
FROM node:24-alpine AS prod

ARG NPM_TOKEN
WORKDIR /metadata-no-match-digest

COPY ./.npmrc ./
COPY ./package* ./
COPY ./jobs/metadata-no-match-digest/package* ./jobs/metadata-no-match-digest/
COPY ./shared/database/package* ./shared/database/

RUN npm install --omit=dev && rm -f .npmrc

COPY --link --from=builder /jobs/metadata-no-match-digest/dist ./jobs/metadata-no-match-digest/dist
COPY --link --from=builder /shared/database/dist ./shared/database/dist

# A single indexed range scan (flowsheet_updated_at_idx) plus one LEFT JOIN
# against shows by primary key -- the API's tight 5s default statement
# timeout is already generous for this job. Left at the default
# deliberately (no override): unlike the paged sweeps and backfills, this
# is a short read-only job with no bulk write pass, so it doesn't need the
# long-timeout / async-commit tuning those jobs carry.

# Identifies the connection in pg_stat_activity during triage.
ENV DB_APPLICATION_NAME=wxyc-metadata-no-match-digest

ENTRYPOINT ["node", "/metadata-no-match-digest/jobs/metadata-no-match-digest/dist/job.js"]
