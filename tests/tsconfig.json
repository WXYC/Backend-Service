{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "rootDir": "..",
    "esModuleInterop": true,
    "strict": false,
    "allowJs": true,
    "skipLibCheck": true,
    "declaration": false,
    "noEmit": true,
    "isolatedModules": true,
    "baseUrl": "..",
    "paths": {
      "@/*": ["apps/backend/*"],
      "@wxyc/database": ["shared/database/src/index.ts"],
      "@wxyc/database/streaming-merge-sql": ["shared/database/src/streaming-merge-sql.ts"],
      "@wxyc/observability/job-logger": ["shared/observability/src/job-logger.ts"],
      "@wxyc/observability/metrics": ["shared/observability/src/metrics.ts"],
      "@wxyc/observability/posthog": ["shared/observability/src/posthog-reporter.ts"],
      "@wxyc/observability/sentry": ["shared/observability/src/sentry-reporter.ts"]
    },
    "types": ["jest", "node"]
  },
  "include": ["**/*.ts", "../apps/backend/**/*.ts"],
  "exclude": ["node_modules"]
}
