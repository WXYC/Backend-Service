# Donate entry point (BS#2111). DONATE_ENABLED is strict-'true' gated — only
# the exact string 'true' enables it; '1'/'TRUE'/'yes' do not. Both stay
# unset for the dark ship: DONATE_URL defaults to '' and DONATE_ENABLED
# defaults to false until an operator sets them on the EC2 host (this service
# does not run on Railway) via .github/workflows/set-ec2-env-var.yml, which
# upserts into ~/.env and recreates the backend container.
DONATE_URL=
DONATE_ENABLED=

