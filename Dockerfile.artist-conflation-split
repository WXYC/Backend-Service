#Build stage
FROM node:24-alpine AS builder

WORKDIR /artist-conflation-split-builder

COPY ./package.json ./package-lock.json ./
COPY ./tsconfig.base.json ./
COPY ./shared/database ./shared/database
COPY ./jobs/artist-conflation-split ./jobs/artist-conflation-split

RUN npm ci && npm run build --workspace=@wxyc/database --workspace=@wxyc/artist-conflation-split

#Production stage
FROM node:24-alpine AS prod

WORKDIR /artist-conflation-split

COPY ./package* ./
COPY ./jobs/artist-conflation-split/package* ./jobs/artist-conflation-split/
COPY ./shared/database/package* ./shared/database/

RUN npm install --omit=dev

COPY --from=builder ./artist-conflation-split-builder/jobs/artist-conflation-split/dist ./jobs/artist-conflation-split/dist
COPY --from=builder ./artist-conflation-split-builder/shared/database/dist ./shared/database/dist

# Bulk repoint workload. Async commit is safe: the job is idempotent (a split
# directive re-validates as already-applied and is refused on a re-run) and
# each directive's writes are one transaction. High statement timeout so a
# directive under live load does not abort mid-split.
ENV DB_APPLICATION_NAME=wxyc-artist-conflation-split
ENV DB_STATEMENT_TIMEOUT_MS=900000
ENV DB_SYNCHRONOUS_COMMIT=off

# ENTRYPOINT + empty CMD so docker-level args (e.g. `--execute`) pass through to
# the job rather than replacing the launcher. node resolves `@wxyc/database` via
# the standard walk up to /artist-conflation-split/node_modules.
ENTRYPOINT ["node", "/artist-conflation-split/jobs/artist-conflation-split/dist/job.js"]
CMD []
