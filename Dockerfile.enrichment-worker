# Long-running CDC consumer (BS#892 / Epic C C2). Subscribes to BS's
# `pg_notify('cdc')` channel and enriches every new flowsheet track row via
# LML. Inbound concurrency is bounded by the shared `Semaphore(5)` +
# `TokenBucket(50/min)` chokepoint in `@wxyc/lml-client`; per-row claim and
# finalize UPDATEs are single-row PK lookups that finish in milliseconds.
# Runs alongside `backend` + `auth` on the same EC2; independent restart
# cycle per `--restart unless-stopped` in the deploy-service action.

# Build stage: consumes the shared dist-export image (built once per deploy
# by Dockerfile.deploy-builder) instead of running its own npm ci + build.
# See docs/deploy.md "Shared builder image".
ARG BUILDER_IMAGE=wxyc-deploy-builder:local
FROM ${BUILDER_IMAGE} AS builder

#Production stage
FROM node:24-alpine AS prod

ARG NPM_TOKEN
WORKDIR /enrichment-worker

COPY ./.npmrc ./
COPY ./package* ./
COPY ./apps/enrichment-worker/package* ./apps/enrichment-worker/
COPY ./shared/database/package* ./shared/database/
COPY ./shared/lml-client/package* ./shared/lml-client/
COPY ./shared/metadata/package* ./shared/metadata/
COPY ./shared/observability/package* ./shared/observability/

# `@wxyc/lml-client` declares `@wxyc/shared` as a registry dependency
# (GitHub Packages, `@wxyc:registry` in `.npmrc`). Without NPM_TOKEN +
# .npmrc the prod stage's npm install 401s on @wxyc/shared. Mirrors the
# pattern in Dockerfile.backend.
RUN npm install --omit=dev && rm -f .npmrc

COPY --link --from=builder /apps/enrichment-worker/dist ./apps/enrichment-worker/dist
COPY --link --from=builder /shared/database/dist ./shared/database/dist
COPY --link --from=builder /shared/lml-client/dist ./shared/lml-client/dist
COPY --link --from=builder /shared/metadata/dist ./shared/metadata/dist
COPY --link --from=builder /shared/observability/dist ./shared/observability/dist

# Inherit @wxyc/database's 5s statement timeout default — every query the
# consumer issues is a single-row PK lookup; anything longer is a stuck
# connection or runaway query, not normal load.
ENV DB_APPLICATION_NAME=wxyc-enrichment-worker

CMD ["npm", "start", "--workspace=@wxyc/enrichment-worker"]
