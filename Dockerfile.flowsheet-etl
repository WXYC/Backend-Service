# Build stage: consumes the shared dist-export image (built once per deploy
# by Dockerfile.deploy-builder) instead of running its own npm ci + build.
# See docs/deploy.md "Shared builder image".
ARG BUILDER_IMAGE
FROM ${BUILDER_IMAGE} AS builder

#Production stage
FROM node:24-alpine AS prod

WORKDIR /flowsheet-etl

COPY ./package* ./
COPY ./jobs/flowsheet-etl/package* ./jobs/flowsheet-etl/
COPY ./shared/database/package* ./shared/database/

RUN npm install --omit=dev

COPY --from=builder /jobs/flowsheet-etl/dist ./jobs/flowsheet-etl/dist
COPY --from=builder /shared/database/dist ./shared/database/dist

# Override the @wxyc/database default of 5s. ETL UPDATE/SELECT batches can
# legitimately take tens of seconds on the 2.6M-row flowsheet table. The
# 5min cap still keeps a runaway query from wedging the cron tick. See
# shared/database/src/client.ts for the rationale.
ENV DB_STATEMENT_TIMEOUT_MS=300000
ENV DB_APPLICATION_NAME=wxyc-flowsheet-etl

CMD ["npm", "start", "--workspace=@wxyc/flowsheet-etl"]
