# Build stage: consumes the shared dist-export image (built once per deploy
# by Dockerfile.deploy-builder) instead of running its own npm ci + build.
# See docs/deploy.md "Shared builder image".
ARG BUILDER_IMAGE=wxyc-deploy-builder:local
FROM ${BUILDER_IMAGE} AS builder

#Production stage
FROM node:24-alpine AS prod

WORKDIR /library-etl

COPY ./package* ./
COPY ./jobs/library-etl/package* ./jobs/library-etl/
COPY ./shared/database/package* ./shared/database/

RUN npm install --omit=dev

COPY --from=builder /jobs/library-etl/dist ./jobs/library-etl/dist
COPY --from=builder /shared/database/dist ./shared/database/dist

# Override the @wxyc/database default of 5s. Bulk ETL queries (legacy joins,
# album/release reconciliation passes) can run tens of seconds on a fresh
# library cache. Without this override the cron tick would 5s-timeout. See
# shared/database/src/client.ts for the rationale.
ENV DB_STATEMENT_TIMEOUT_MS=300000
ENV DB_APPLICATION_NAME=wxyc-library-etl

CMD ["npm", "start", "--workspace=@wxyc/library-etl"]