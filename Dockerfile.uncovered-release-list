# Build stage: consumes the shared dist-export image (built once per deploy
# by Dockerfile.deploy-builder) instead of running its own npm ci + build.
# See docs/deploy.md "Shared builder image".
ARG BUILDER_IMAGE=wxyc-deploy-builder:local
FROM ${BUILDER_IMAGE} AS builder

#Production stage
FROM node:24-alpine AS prod

WORKDIR /uncovered-release-list

ENV DB_STATEMENT_TIMEOUT_MS=60000
ENV DB_APPLICATION_NAME=wxyc-uncovered-release-list

COPY ./package* ./
COPY ./jobs/uncovered-release-list/package* ./jobs/uncovered-release-list/
COPY ./shared/database/package* ./shared/database/

RUN npm install --omit=dev

COPY --from=builder /jobs/uncovered-release-list/dist ./jobs/uncovered-release-list/dist
COPY --from=builder /shared/database/dist ./shared/database/dist

# ENTRYPOINT + empty CMD so docker-level args (e.g. `--backfill`, `--dry-run`)
# pass through to the job rather than replacing the launcher.
ENTRYPOINT ["node", "/uncovered-release-list/jobs/uncovered-release-list/dist/job.js"]
CMD []
