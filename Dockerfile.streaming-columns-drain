#Build stage
FROM node:24-alpine AS builder

ARG NPM_TOKEN
WORKDIR /streaming-columns-drain-builder

COPY ./.npmrc ./
COPY ./package.json ./package-lock.json ./
COPY ./tsconfig.base.json ./
COPY ./shared/database ./shared/database
COPY ./shared/lml-client ./shared/lml-client
COPY ./shared/metadata ./shared/metadata
COPY ./jobs/streaming-columns-drain ./jobs/streaming-columns-drain

RUN npm ci && npm run build --workspace=@wxyc/database --workspace=@wxyc/lml-client --workspace=@wxyc/metadata --workspace=@wxyc/streaming-columns-drain

#Production stage
FROM node:24-alpine AS prod

ARG NPM_TOKEN
WORKDIR /streaming-columns-drain

COPY ./.npmrc ./
COPY ./package* ./
COPY ./jobs/streaming-columns-drain/package* ./jobs/streaming-columns-drain/
COPY ./shared/database/package* ./shared/database/
COPY ./shared/lml-client/package* ./shared/lml-client/
COPY ./shared/metadata/package* ./shared/metadata/

# `@wxyc/lml-client` declares `@wxyc/shared` as a registry dependency
# (GitHub Packages, `@wxyc:registry` in `.npmrc`). Without NPM_TOKEN +
# .npmrc the prod stage's npm install 401s on @wxyc/shared. Mirrors the
# pattern in Dockerfile.flowsheet-metadata-backfill / Dockerfile.backend.
RUN npm install --omit=dev && rm -f .npmrc

COPY --from=builder ./streaming-columns-drain-builder/jobs/streaming-columns-drain/dist ./jobs/streaming-columns-drain/dist
COPY --from=builder ./streaming-columns-drain-builder/shared/database/dist ./shared/database/dist
COPY --from=builder ./streaming-columns-drain-builder/shared/lml-client/dist ./shared/lml-client/dist
COPY --from=builder ./streaming-columns-drain-builder/shared/metadata/dist ./shared/metadata/dist

# Identifies the connection in pg_stat_activity during incident triage.
ENV DB_APPLICATION_NAME=wxyc-streaming-columns-drain

# ENTRYPOINT + empty CMD so docker-level args (e.g. `--dry-run`) pass through
# to the job rather than replacing the launcher. With `CMD ["npm", "start"]`,
# `docker run <image> --dry-run` replaces the whole command and node tries to
# parse `--dry-run` itself. ENTRYPOINT pins the launcher; any args after
# `<image>` extend it. node resolves `@wxyc/database` etc. via the standard
# walk up to /streaming-columns-drain/node_modules.
ENTRYPOINT ["node", "/streaming-columns-drain/jobs/streaming-columns-drain/dist/job.js"]
CMD []
