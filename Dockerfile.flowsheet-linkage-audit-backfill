# Build stage: consumes the shared dist-export image (built once per deploy
# by Dockerfile.deploy-builder) instead of running its own npm ci + build.
# See docs/deploy.md "Shared builder image".
ARG BUILDER_IMAGE=wxyc-deploy-builder:local
FROM ${BUILDER_IMAGE} AS builder

#Production stage
FROM node:24-alpine AS prod

WORKDIR /flowsheet-linkage-audit-backfill

COPY ./package* ./
COPY ./jobs/flowsheet-linkage-audit-backfill/package* ./jobs/flowsheet-linkage-audit-backfill/
COPY ./shared/database/package* ./shared/database/

RUN npm install --omit=dev

COPY --link --from=builder /jobs/flowsheet-linkage-audit-backfill/dist ./jobs/flowsheet-linkage-audit-backfill/dist
COPY --link --from=builder /shared/database/dist ./shared/database/dist

CMD ["npm", "start", "--workspace=@wxyc/flowsheet-linkage-audit-backfill"]
