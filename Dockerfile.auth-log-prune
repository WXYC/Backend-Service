#Build stage
FROM node:24-alpine AS builder

ARG NPM_TOKEN
WORKDIR /auth-log-prune-builder

COPY ./.npmrc ./
COPY ./package.json ./package-lock.json ./
COPY ./tsconfig.base.json ./
COPY ./shared/database ./shared/database
COPY ./shared/authentication ./shared/authentication
COPY ./jobs/auth-log-prune ./jobs/auth-log-prune

RUN npm ci && npm run build --workspace=@wxyc/database --workspace=@wxyc/authentication --workspace=@wxyc/auth-log-prune

#Production stage
FROM node:24-alpine AS prod

ARG NPM_TOKEN
WORKDIR /auth-log-prune

COPY ./.npmrc ./
COPY ./package* ./
COPY ./jobs/auth-log-prune/package* ./jobs/auth-log-prune/
COPY ./shared/database/package* ./shared/database/
COPY ./shared/authentication/package* ./shared/authentication/

RUN npm install --omit=dev && rm -f .npmrc

COPY --from=builder ./auth-log-prune-builder/jobs/auth-log-prune/dist ./jobs/auth-log-prune/dist
COPY --from=builder ./auth-log-prune-builder/shared/database/dist ./shared/database/dist
COPY --from=builder ./auth-log-prune-builder/shared/authentication/dist ./shared/authentication/dist

# A single DELETE against a table bounded by the retention window itself —
# the API's 5s default statement timeout is fine here, unlike the paged
# multi-million-row sweeps that override it.

# Identifies the connection in pg_stat_activity during triage.
ENV DB_APPLICATION_NAME=wxyc-auth-log-prune

ENTRYPOINT ["node", "/auth-log-prune/jobs/auth-log-prune/dist/job.js"]
