# Build stage: consumes the shared dist-export image (built once per deploy
# by Dockerfile.deploy-builder) instead of running its own npm ci + build.
# See docs/deploy.md "Shared builder image".
ARG BUILDER_IMAGE
FROM ${BUILDER_IMAGE} AS builder

#Production stage
FROM node:24-alpine AS prod

WORKDIR /legacy-linkage-resolve

COPY ./package* ./
COPY ./jobs/legacy-linkage-resolve/package* ./jobs/legacy-linkage-resolve/
COPY ./shared/database/package* ./shared/database/

RUN npm install --omit=dev

COPY --from=builder /jobs/legacy-linkage-resolve/dist ./jobs/legacy-linkage-resolve/dist
COPY --from=builder /shared/database/dist ./shared/database/dist

# Override the @wxyc/database default of 5s. See shared/database/src/client.ts.
ENV DB_STATEMENT_TIMEOUT_MS=300000
ENV DB_APPLICATION_NAME=wxyc-legacy-linkage-resolve

CMD ["npm", "start", "--workspace=@wxyc/legacy-linkage-resolve"]
