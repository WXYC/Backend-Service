# Build stage: consumes the shared dist-export image (built once per deploy
# by Dockerfile.deploy-builder) instead of running its own npm ci + build.
# See docs/deploy.md "Shared builder image".
ARG BUILDER_IMAGE=wxyc-deploy-builder:local
FROM ${BUILDER_IMAGE} AS builder

#Production stage
FROM node:24-alpine AS prod

WORKDIR /artist-search-alias-consumer

ENV DB_STATEMENT_TIMEOUT_MS=60000
ENV DB_APPLICATION_NAME=wxyc-artist-search-alias-consumer

COPY ./package* ./
COPY ./jobs/artist-search-alias-consumer/package* ./jobs/artist-search-alias-consumer/
COPY ./shared/database/package* ./shared/database/

RUN npm install --omit=dev

COPY --from=builder /jobs/artist-search-alias-consumer/dist ./jobs/artist-search-alias-consumer/dist
COPY --from=builder /shared/database/dist ./shared/database/dist

CMD ["npm", "start", "--workspace=@wxyc/artist-search-alias-consumer"]
